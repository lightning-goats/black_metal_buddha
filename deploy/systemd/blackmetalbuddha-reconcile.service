[Unit]
Description=Black Metal Buddha provider reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=blackmetalbuddha
Group=blackmetalbuddha
WorkingDirectory=/opt/blackmetalbuddha/current
EnvironmentFile=/etc/blackmetalbuddha/blackmetalbuddha.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/blackmetalbuddha/venv/bin/python -m app.manage reconcile

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
