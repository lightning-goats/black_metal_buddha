[Unit]
Description=Black Metal Buddha storefront
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackmetalbuddha
Group=blackmetalbuddha
WorkingDirectory=/opt/blackmetalbuddha/current
EnvironmentFile=/etc/blackmetalbuddha/blackmetalbuddha.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/blackmetalbuddha/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=027

[Install]
WantedBy=multi-user.target
