[Unit]
Description=Black Metal Buddha storefront
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackmetalbuddha
Group=blackmetalbuddha
WorkingDirectory=/opt/blackmetalbuddha/current
EnvironmentFile=/etc/blackmetalbuddha/blackmetalbuddha.env
ExecStart=/opt/blackmetalbuddha/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
