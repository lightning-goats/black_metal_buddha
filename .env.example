# Phase 1 defaults are intentionally safe.
APP_ENV=production
PUBLIC_BASE_URL=https://blackmetalbuddha.com
DATABASE_URL=postgresql+psycopg://blackmetalbuddha:CHANGE_ME@127.0.0.1/blackmetalbuddha

# Keep false until the Square/Printful pipeline is intentionally enabled.
PHASE1_API_ENABLED=false

SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://blackmetalbuddha.com/api/v1/webhooks/square

# disabled = no Printful calls, draft = create/reconcile drafts only.
# Production fulfillment remains blocked until a later implementation.
PRINTFUL_MODE=disabled
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_WEBHOOK_SECRET_KEY=

# Both must remain false until physical sample validation passes and
# the production canary is explicitly authorized.
PHASE0_5_APPROVED=false
PRINTFUL_CONFIRM_ENABLED=false

# Transactional email. Keep disabled until a provider/SMTP relay is selected.
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
